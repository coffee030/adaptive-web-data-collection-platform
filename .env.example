# Local Compose only. Replace the placeholder before starting PostgreSQL.
POSTGRES_USER=collection
POSTGRES_PASSWORD=
POSTGRES_DB=collection_dev
POSTGRES_PORT=5432
# Optional full override. Use the postgresql+psycopg driver.
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/database
EVIDENCE_ROOT=var/evidence

# Host worker/dispatcher only. Compose uses its private redis service.
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
