map $http_host $loopback_host {
    default 0;
    "~^127\.0\.0\.1:[0-9]{1,5}$" 1;
}

map "$http_origin|$http_host" $same_origin {
    default 0;
    "~^http://(127\.0\.0\.1:[0-9]{1,5})\|\1$" 1;
}

map "$request_method:$uri" $approval_route {
    default 0;
    "~^POST:/api/v1/sources/[^/]+/versions/[^/]+/approve/?$" 1;
    "~^POST:/api/v1/topics/[^/]+/bindings(?:/[^/]+/(?:approve|disable))?/?$" 1;
}

map "$approval_route:${LOCAL_PROFILE_APPROVAL}:$same_origin" $deny_approval {
    default 0;
    "~^1:" 1;
    "1:1:1" 0;
}

server {
    listen 8080 default_server;
    server_name _;
    root /usr/share/nginx/html;
    access_log off;
    client_max_body_size 6152k;
    client_body_timeout 15s;
    client_header_timeout 15s;

    if ($loopback_host = 0) { return 403; }

    location /api/v1/ {
        default_type application/json;
        if ($deny_approval) {
            return 403 '{"error":{"code":"local_approval_required","message":"Local operator approval requires the same loopback origin"}}';
        }

        resolver 127.0.0.11 valid=5s ipv6=off;
        resolver_timeout 2s;
        set $backend api:8000;
        proxy_pass http://$backend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_connect_timeout 2s;
        proxy_read_timeout 60s;
        proxy_redirect off;
    }

    location = /harbourline-installation.json {
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }
    location /api/ { return 404; }
    location /assets/ { try_files $uri =404; }
    location /licenses/ { try_files $uri =404; }
    location / { try_files $uri $uri/ /index.html; }
}
